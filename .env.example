# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Never put real card numbers or API keys in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# Must be publicly reachable for approval links and webhooks to work.
# Local dev: run `ngrok http 3100` and paste the https URL here.
PUBLIC_BASE_URL=http://localhost:3100

# Signs approval links. Generate with: openssl rand -base64 32
CALLBACK_SIGNING_SECRET=

# --- Persistence -----------------------------------------------------------
STORE_DRIVER=file          # file | memory
STORE_FILE_PATH=./.data/mandates.json

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Prava -----------------------------------------------------------------
PRAVA_ENV=sandbox             # sandbox -> https://sandbox.api.prava.space
PRAVA_API_KEY=                # sk_test_...
PRAVA_WEBHOOK_SECRET=
# PRAVA_API_BASE=             # only to override the host derived from PRAVA_ENV

# Prava requires an identity on every secret-key session.
REQUESTER_EMAIL=purchasing@yourteam.test

# --- Merchant and checkout mode ---------------------------------------------
# live_decline : drive a real merchant with sandbox credentials. The gateway
#                WILL decline; the decline is captured and reported to Prava as
#                DECLINED. Prava confirmed this counts as a successful sandbox
#                transaction as long as the decline is shown honestly.
# dev_store    : drive your own Shopify development store with test payments
#                enabled. The only way to exercise the APPROVED branch.
CHECKOUT_MODE=live_decline
MERCHANT_ID=littlebox_india   # see src/config/merchants.ts for the list
DEV_STORE_URL=                # required when CHECKOUT_MODE=dev_store (https)
DEV_STORE_NAME=Hackiechan Test Store

# --- Prava sandbox test card ------------------------------------------------
# Only used if mandate charge is unavailable. TEAM-SPECIFIC, 30 transactions a
# day, which is why these live in .env and never in the repo.
PRAVA_TEST_CARD_NUMBER=
PRAVA_TEST_CARD_CVV=
PRAVA_TEST_CARD_EXPIRY=       # MM/YY
PRAVA_TEST_CARD_ID=

# --- Linq (iMessage) -------------------------------------------------------
LINQ_API_BASE=https://api.linqapp.com
LINQ_API_TOKEN=
LINQ_PHONE_NUMBER=
LINQ_WEBHOOK_SECRET=

# --- Browserbase / Stagehand ------------------------------------------------
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
CHECKOUT_ENABLED=true
CHECKOUT_TIMEOUT_MS=180000
EVIDENCE_DIR=./.data/evidence

# --- Org routing -----------------------------------------------------------
ORG_NAME=Hackiechan Labs
APPROVER_NAME=Finance Approver
APPROVER_PHONE=              # who receives passkey requests; defaults to the requester

# --- Guardrails (US cents) --------------------------------------------------
POLICY_AUTO_APPROVE_CENTS=2500        # $25.00 unattended
POLICY_APPROVAL_REQUIRED_CENTS=10000  # $100.00 hard ceiling
POLICY_MONTHLY_BUDGET_CENTS=50000     # $500.00 per person per month
MANDATE_TTL_MINUTES=30
